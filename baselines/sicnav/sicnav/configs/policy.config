[campc]
horiz = 4
        # MPC horizon

soft_constraints = true
        # soften constraints by adding penalized slack

soft_dyn_consts = false
ineq_dyn_consts = false

term_const = false
        # whether to have a terminal MPC constraint

ref_type = point_stab
        # reference signal for MPC controller can be path_foll, traj_track, point_stab

new_ref_each_step = false
        # re-calculate a new reference each step

warmstart = true
        # whether or not to use a warmstart strategy for solving mpc

# NB set up to one of these to true (either neither, cvmm or MID)
human_goal_cvmm = true
human_pred_MID = false
human_pred_MID_joint = true
human_pred_MID_vanil_as_joint = false
human_pred_AF = false
MID_stateful_weights = true

human_goal_cvmm_horizon = 3.0
min_hum_max_speed = 0.02
randomize_rob_goal = true



[mpc_env]
hum_model = orca_casadi_kkt
        # the model CAMPC uses for humans can be 'orca_casadi_kkt' (for SICNav-p and SICNav-np) or 'cvmm' (for MPC-CVMM baseline)

priviledged_info = false
        # if human model is orca_casadi_kkt, whether the robot has access to priviledged info (SICNav-p) or not (SICNav-np)

orca_kkt_horiz = 4
        # if human model is orca_casadi_kkt, the subset of the horizon where ORCA constraints are used to model humans

rob_len_buffer = 0.2
rob_wid_buffer = 0.05
rob_stat_buffer = 0.08

human_v_max_assumption = 1.0
        # if human model is orca_casadi_kkt and priviledged_info is false, the robot assumption about human maximum speed
        # Held common with crowdnav_env's actual simulated humans: [humans] v_pref=1 in
        # crowd_nav/configs/env.config, and crowd_sim/envs/policy/orca.py's own ORCA policy hardcodes
        # max_speed=1 for those humans (not read from config there). The previous value of 0.5 made
        # SICNav-np's non-privileged ORCA-KKT human model assume humans could only move at HALF their
        # real speed, which (confirmed empirically -- see crowd_nav/policy/sicnav.py's module docstring)
        # was a major, previously-missed cause of real collisions in evaluation: the model's predictions
        # of how humans would react/move were systematically too conservative about how fast they
        # actually close distance, undermining the whole point of modeling their reactive behavior.

rob_rad_buffer = 0.31
        # buffer to robot radius for mpc collision constraint (mpc_env.py's get_mpc_coll_constraints:
        # comb_rad = human_radius + robot_radius + rob_rad_buffer + 0.01, the required center-to-center
        # separation for the hard/soft collision constraint). True collision is at 0.50 m
        # (crowd_sim.py:1021), so 0.31 here means SICNav plans to 0.82 m.
        #
        # CHOSEN BY POLICY, not by matching a raw number: every baseline gets a planning clearance
        # AT LEAST as large as the method under test, so any win by that method is a lower bound and
        # no baseline can be accused of having been starved of margin. Clearances actually in force:
        #
        #   diffusion CFG / MPPI  0.65 m   safety_radius 0.5 * 1.3 (method under test -- smallest)
        #   SICNav (this key)     0.82 m   0.25 + 0.25 + 0.31 + 0.01
        #   orca_unicycle.py      0.82 m   (0.25+0.01+0.15) * 2 -- RVO2 sums BOTH padded radii
        #   sfm_unicycle.py      ~0.91 m   effective standoff where repulsion balances goal pull
        #   CADRL/SARL/RGL/LSTM   ~0.82 m  inherited: trained by IL from the orca_unicycle teacher
        #                                  at train.config safety_space=0.15 (train.py:152-159)
        #
        # BEWARE the multiplicity trap: these keys are NOT the same physical quantity and their raw
        # values are not commensurable. orca_unicycle inflates both agents' radii; sfm_unicycle
        # spatially shifts a soft exponential force (B=0.18, so it is very sensitive -- do not tune
        # it for "parity"); the diffusion policy states one bundled center-to-center distance. An
        # earlier version of this file set 0.15 "to match orca_unicycle's 0.15" -- that bought only
        # 0.66 m against ORCA's 0.82 m, i.e. half the margin, on the baseline whose reciprocal-human
        # forecast makes it MOST in need of margin here (the robot is invisible to humans in this
        # eval case, env.config [robot] visible=false, so they never reciprocate).
        #
        # NB this is a fairness re-tune, not the SICNav authors' value (originally 0.02) -- report it.
        # Verified to run at this value: full episode, ReachGoal, no solver failure.

pref_speed = 1.0
        # robot preferred speed
        # Held common with crowdnav_env's robot.v_pref (crowd_nav/configs/env.config [robot] v_pref=1)

max_speed = 1.0
        # robot maximum speed
        # Held common with crowdnav_env's [action_space] max_vel=1 (crowd_nav/configs/policy.config)

max_rev_speed = 0.0
        # robot maximum reverse speed
        # Set to 0: crowdnav_env's unicycle action convention (see e.g. crowd_nav/policy/dsrnn.py
        # _clip_action/predict, orca_unicycle.py) never commands negative forward speed, so this is held
        # consistent for a fair, apples-to-apples action space across baselines.

max_rot_degrees = 179.9089876726395
        # Despite the name ("rotation in one time-step"), mpc_env.py's dynamics are
        # next_th_r = th_r + time_step*om_r, and get_kin_bound_constraint() bounds the
        # input om_r itself (rad/s) by [-max_rot, max_rot] with max_rot=max_rot_degrees*pi/180
        # -- i.e. this is a direct bound on angular VELOCITY, not on the rotation achieved
        # in one step (that's om_r*time_step, an emergent quantity, not what's bounded here).
        # Held common with crowdnav_env's [action_space] max_wrot=3.14 rad/s converted
        # to degrees (3.14*180/pi): with time_step=0.25, this makes the achieved per-step
        # rotation cap out at 3.14*0.25=0.785 rad, matching max_wrot*time_step exactly as used
        # by e.g. dsrnn.py's omega_new = clip(prev_omega+domega, -max_wrot, max_wrot) followed by
        # ActionRot(v_new, omega_new*time_step). (A previous version of this file set this to 45,
        # reasoning it as a per-step delta directly -- that was wrong and under-constrained the
        # robot's angular velocity to 1/4 of max_wrot; verified via smoke test that the achieved
        # per-step r matches max_wrot*time_step only with this corrected value.)

max_l_acc = 1.5
        # robot maximum linear acceleration (m/s^2)
        # Held common with crowdnav_env's [action_space] max_accel=1.5 -- mpc_env.py bounds the
        # per-step change in speed by max_l_acc*time_step, the same convention as max_accel*time_step there.

max_w_accel = 3.14
        # robot maximum ANGULAR acceleration (rad/s^2).  [ADDED KEY - not upstream]
        # Held common with crowdnav_env's [action_space] max_w_accel=3.14.
        # Upstream SICNav has no angular-acceleration limit at all, so the host harness's
        # per-step |domega| <= max_w_accel*dt bound had to be imposed by clipping the MPC's
        # command after the fact -- which fired on 34% of steps (vs 10% for ORCA) and
        # invalidated the plan SICNav had committed to. campc.py's get_opti_dict now
        # constrains adjacent columns of the input matrix directly, so the MPC plans
        # trajectories that already respect the limit. Set to inf (or delete the key) to
        # restore upstream behaviour.

max_l_dcc = -1.5
        # robot maximum linear deceleration NB must be negative (m/s^2)
        # Held common with max_l_acc/max_accel above (crowdnav_env's baselines use a single symmetric
        # +-max_accel bound, not separate accel/decel limits).
        # NOTE: crowdnav_env's [action_space] also has a separate max_w_accel (angular acceleration)
        # limit. SICNav's MPC has no internal hard angular-acceleration constraint (only the om_r rad/s bound
        # above and a soft smoothness cost, q_om_prev_dot) -- rather than modify the MPC's constraint set
        # (risky given the bilevel ORCA-KKT formulation), max_w_accel is enforced by post-hoc clipping in
        # crowd_nav/policy/sicnav.py's predict(), the same technique dsrnn.py/navistar.py use for their own
        # unicycle limits. See that adapter's module docstring for details.

orca_ksi_scaling = 1e-2
orca_vxy_scaling = 1e0
orca_lambda_scaling = 1.0
        # if human model is orca_casadi_kkt, scaling variable in orca kkt constraints for better solver performance

# COST PARAMS
q_x = 1.0
q_y = 1.0
q_theta = 0.05
q_v_prev = 2.5
q_om_prev = 0.0
r_om = 50.0
q_v_prev_dot = 3.5
q_om_prev_dot = 0.1
term_q_coeff = 75.0
term_q_theta = 2.0

[humans]
        # The ORCA parameters for the model that SICNav has of the humans. The section in env.config controls the humans in the simulator
        # radius held common with crowdnav_env's humans.radius (crowd_nav/configs/env.config [humans] radius=0.25)
radius = 0.25
sensor = coordinates
safety_space = 0.01
v_pref = 1.5
max_acc = 2.0
neighbor_dist = 10
max_neighbors = 10
time_horizon = 2.5
time_horizon_obst = 1.50
max_speed = 1.0
        # Held common with crowdnav_env's actual simulated humans (max_speed=1, see
        # human_v_max_assumption's comment in [mpc_env] above for the full reasoning). This value
        # feeds ORCACWrapper (orca_c_wrapper.py), a secondary RVO2-based helper used when generating
        # MPC reference trajectories/warmstarts (campc.py's self.mpc_env.callback_orca calls) -- less
        # safety-critical than human_v_max_assumption (which feeds the actual hard ORCA-KKT
        # constraints), but held consistent for the same reason.

[orca_plus]
visible = true
radius = 0.3
safety_space = 0.01
v_pref = 1.5
sensor = coordinates


[dwa]
acc_max = 0.5
ang_acc_max = 1.04
ang_acc_res_deg = 0.5
max_d = 2.0

