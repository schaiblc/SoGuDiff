[env]
time_limit = 25
time_step = 0.25
val_size = 10
test_size = 500
randomize_attributes = false


[reward]
success_reward = 1
collision_penalty = -0.25
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5


[sim]
testoffset = 10
train_val_sim = evaluation
test_sim = evaluation
square_width = 15
circle_radius = 4
human_num = 5


[humans]
visible = true
policy = orca
radius = 0.25
v_pref = 1
sensor = coordinates


[robot]
visible = false
policy = none
radius = 0.25
v_pref = 1
sensor = coordinates
