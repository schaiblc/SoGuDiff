# Architecture snapshot taken when this checkpoint was trained. The
# evaluation harness reads it via --model_dir, so these values must keep
# matching the weights beside them. Sections for other policies were
# present in the original snapshot and have been removed.

# policy configurations for robot

[rl]
gamma = 0.9


[om]
cell_num = 4
cell_size = 1
om_channel_size = 3


[action_space]
kinematics = unicycle
enforce_lims = true
max_vel = 1
max_wrot = 3.14
max_accel = 1.5
max_w_accel = 3.14
# action space size is speed_samples * rotation_samples + 1
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true


[rgl]
# Matches RelationalGraphLearning's ICRA-benchmark rgl.py / BasePolicyConfig
# defaults (gcn.* in their configs/icra_benchmark/config.py).
num_layer = 2
X_dim = 32
wr_dims = 64, 32
wh_dims = 64, 32
final_state_dim = 32
gcn2_w1_dim = 32
planning_dims = 150, 100, 100, 1
similarity_function = embedded_gaussian
layerwise_graph = false
skip_connection = true
multiagent_training = true


