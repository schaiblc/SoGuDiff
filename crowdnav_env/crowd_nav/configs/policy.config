# policy configurations for robot

[rl]
gamma = 0.9


[om]
cell_num = 4
cell_size = 1
om_channel_size = 3


[action_space]
kinematics = unicycle
enforce_lims = true
max_vel = 1
max_wrot = 3.14
max_accel = 1.5
max_w_accel = 3.14
# action space size is speed_samples * rotation_samples + 1
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true


[cadrl]
mlp_dims = 150, 100, 100, 1
multiagent_training = false


[lstm_rl]
global_state_dim = 50
mlp1_dims = 150, 100, 100, 50
mlp2_dims = 150, 100, 100, 1
multiagent_training = true
with_om = false
with_interaction_module = false


[sarl]
mlp1_dims = 150, 100
mlp2_dims = 100, 50
attention_dims = 100, 100, 1
mlp3_dims = 150, 100, 100, 1
multiagent_training = true
with_om = false
with_global_state = true


[rgl]
# Matches RelationalGraphLearning's ICRA-benchmark rgl.py / BasePolicyConfig
# defaults (gcn.* in their configs/icra_benchmark/config.py).
num_layer = 2
X_dim = 32
wr_dims = 64, 32
wh_dims = 64, 32
final_state_dim = 32
gcn2_w1_dim = 32
planning_dims = 150, 100, 100, 1
similarity_function = embedded_gaussian
layerwise_graph = false
skip_connection = true
multiagent_training = true


[dsrnn_holonomic]
# Adapter crowd_nav/policy/dsrnn.py (DSRNNHolonomic). DIAGNOSTIC arm: the
# checkpoint under its native holonomic dynamics, with no unicycle projection.
# Not a reported row -- the comparison table uses [dsrnn] below, which enforces
# the shared action space. This arm exists only to measure what that
# enforcement costs, and is not comparable to the table rows.
#
# The checkpoint keeps the authors' dynamics and PPO recipe (holonomic
# ActionXY, clip-to-v_pref, entropy 0.0, lr 4e-5, no lr decay, 10e6 steps) and
# changes only the surrounding task to this repository's evaluation scenario:
# 1..10 humans with closest-N selection and padding, radii 0.25, 25 s time
# limit, fixed per-episode human goals.
dsrnn_root = baselines/dsrnn
checkpoint = baselines/dsrnn/data/trained/checkpoints/best.pt


[dsrnn]
# Adapter crowd_nav/policy/dsrnn.py (DSRNN). This is the reported DSRNN row.
#
# Same checkpoint as [dsrnn_holonomic], with its holonomic (vx, vy) output
# projected at evaluation time onto the shared unicycle envelope via
# unicycle_utils.project_velocity_to_unicycle -- the same projection
# ORCAUnicycle and SFMUnicycle use, with limits from [action_space] and
# enforce_lims forced True. kinematics='unicycle', so the environment
# integrates heading. Retraining DSRNN unicycle-native did not converge, so
# enforcing the limits at evaluation is how it is brought onto the common
# action space.
dsrnn_root = baselines/dsrnn
checkpoint = baselines/dsrnn/data/trained/checkpoints/best.pt


[navistar]
# Evaluation-only adapter (crowd_nav/policy/navistar.py, NaviSTAR) —
# loads the retrain from baselines/navistar: the authors' own SAC/STAR recipe
# kept wholesale (train_sac.py, CrowdSim-v0, num_seed_steps 5000, batch 1024,
# best-checkpoint-on-eval-SR), changed ONLY in the surrounding task: this
# repo's 'evaluation' scenario, ACTUAL crowd size 1..10 per episode with
# fixed 10+1-slot padded observations (unused slots at exactly (15, 15),
# visibility-masked), radii 0.25, time_limit 25. best_sac_actor.pt is the
# checkpoint train_sac.py re-saves every time the rolling 50-episode eval SR
# improves. Same A/B protocol as dsrnn_holonomic: 'navistar' runs unicycle-
# projected under [action_space]; 'navistar_holonomic' is the raw
# holonomic diagnostic arm.
navistar_root = baselines/navistar
checkpoint = baselines/navistar/data/navigation/star_sac/checkpoints/best_sac_actor.pt
# Unused-slot pad value is NOT derived here: NaviSTAR pins 15.0 in code,
# the exact value its training env padded with (see navistar.py
# _pad_offset_override). Kept as a documentation placeholder only.
square_width_for_padding = 15


[height]
# Both HEIGHT arms read this section.
# Evaluation-only adapter (crowd_nav/policy/height.py) — loads the
# retrain from baselines/height: HEIGHT's non-lidar selfAttn_merge_SRNN
# trained with the author's OWN PPO stack on the author's own non-pybullet
# CrowdSimVarNum-v0 env, changed ONLY in the surrounding task ('evaluation'
# scenario, 1..10 actual humans with fixed 10-slot padded observations at
# (15,15), radii 0.25, v_pref 1, time_step 0.25, time_limit 25). best.pt is
# selected by rolling mean training reward (>=50 episodes), the same protocol
# the DSRNN fork's train.py uses. 'height' projects onto the unicycle envelope
# via [action_space] and is the reported row; 'height_holonomic' is the
# unprojected diagnostic arm and is not reported.
height_root = baselines/height
checkpoint = baselines/height/data/trained/checkpoints/best.pt


[sicnav]
# Evaluation-only adapter (crowd_nav/policy/sicnav.py) — wraps SICNav-np
# (sicnav/policy/campc.py's CollisionAvoidMPC with hum_model=orca_casadi_kkt,
# priviledged_info=false), a CasADi/IPOPT MPC baseline from the separate
# SICNav repo. Not a learned policy, so no checkpoint/retraining — this
# adapter constructs and configures CollisionAvoidMPC from SICNav's own
# sicnav/configs/policy.config, which has been edited there to match this
# repo's unicycle action limits and human radius (see that file's comments
# for the full mapping and the one documented gap, an angular-acceleration
# constraint SICNav's MPC has no equivalent for). sicnav_root points at that
# repo so the adapter can import its sicnav.policy.campc / crowd_sim_plus
# code and load its own policy.config for CollisionAvoidMPC.configure().
sicnav_root = baselines/sicnav


[sogudiff]
cfg_weight = 1
cfg_w_scene = 1.0
cfg_w_style = 5.0
norm_file = crowdnav_env/crowd_nav/sogudiff_norm_stats.npy
start_dim = 2
goal_dim = 2
token_dim = 128
multiagent_training = true
ckpt_path = checkpoints/sogudiff_single_axis.pt
horizon = 32
k_max = 10
num_diffusion_timesteps = 100
num_inference_steps = 20
ddim_inference = true
num_samples = 5
collision_coef = 10
smooth_pen_coef = 1
goal_reward_coef = 5
safety_radius = 0.5
control_effort_coef = 0.5
use_projection = true
proj_max_dev_thresh = 5.0
proj_max_penetration_thresh = 0.1
proj_solver_mode = SQP
proj_sqp_max_iter = 5
proj_sqp_tol = 1e-3
k_static = 20
use_map = true
map_size = 50
map_extent = 10
style_vector = 0.0, 0.0, 0.0, 0.0
use_amp = true
amp_dtype = bfloat16
trained_cfg_mode = union
cfg_infer_mode   = joint


[mppi_expert]
# reuse the diffusion block's projection + scoring keys verbatim so the two
# policies are configured identically:
safety_radius = 0.5
use_projection = true
proj_max_dev_thresh = 5.0
proj_max_penetration_thresh = 0.1
# These MUST match the [sogudiff] block. This ablation is only meaningful if the
# two policies share the projection back-end, so that a metric difference is
# attributable to the planner (online search vs. denoising) rather than to the
# feasibility layer. RTI here against SQP there is 1 solver iteration vs 5:
# different executed trajectories, different clearance, different deviation
# from the candidate — i.e. exactly the confound this baseline exists to avoid.
proj_solver_mode = SQP
proj_sqp_max_iter = 5
proj_sqp_tol = 1e-3
k_static = 20
use_map = true
map_size = 50
map_extent = 10
style_vector = 0.0, 0.0, 0.0, 0.0
collision_coef = 10
smooth_pen_coef = 1
goal_reward_coef = 5
control_effort_coef = 0.5
# ---------------------------------------------------------------------------
# Search budget, as a fraction of the demonstration generator's full search.
#
# 1.0 reproduces the generator's search exactly -- its constants are the source
# of truth and are read from the module at configure time:
#     samples = 2048   iterations = 12   restarts = 8   seed pool = 18432
# This is the setting behind the reported online-expert ablation, which runs
# the full-budget sampler online as a policy.
#
# Lower values scale the seed pool and sample count together (the two
# components carrying essentially all the compute). Restarts and iteration
# count are deliberately NOT scaled: restarts are the mechanism that discovers
# distinct homotopy modes, and iterations set refinement depth, so scaling
# either changes what the planner is rather than how much compute it gets.
#
# mppi_samples / mppi_seed_pool / mppi_iters / mppi_restarts override the
# budget-derived values individually if you need to probe one component.
#
# DEFAULT vs PAPER: the default here is 0.001, which keeps this baseline
# runnable on a single machine -- at 1.0 it performs thousands of rollouts per
# control step and a 500-scene evaluation takes many GPU-hours. The reported
# ablation used the full budget. Set mppi_budget = 1.0 to reproduce it, and
# expect a long run.
# ---------------------------------------------------------------------------
mppi_budget = 0.001
# Base RNG seed so an evaluation run replays exactly (offline the expert seeds
# per scene+style; online we seed base + per-call counter). Use -1 for a
# genuinely nondeterministic sampler.
mppi_seed = 0
horizon = 32
# Point at the CANONICAL expert generator — the same file the SLURM chain
# (generate_EXPERT_TRAJS_LOOP.slurm) ran to produce the training demonstrations.
# The experiment's claim is that the online planner is provably the SAME
# instrument as the offline expert, so this must never be a copy that can drift.
expert_module = sogudiff/generate_expert_trajectories.py