logs/
results_*/
wandb/
mppi_sweep_results/

# docs/INSTALL.md builds acados into third_party/ inside the clone
third_party/

# acados generates a C project per solver build, named by process/job id
c_generated_proj*/
acados_*_ocp_*.json
acados_ocp*.json

